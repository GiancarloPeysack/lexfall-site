{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.lexfall.app" }], "destination": "https://lexfall.app/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "luxfall.online" }], "destination": "https://lexfall.app/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.luxfall.online" }], "destination": "https://lexfall.app/$1", "permanent": true },
    { "source": "/get/:src", "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }], "destination": "/google-play", "permanent": false },
    { "source": "/get/:src", "destination": "https://apps.apple.com/app/id6786614029?pt=128225052&ct=:src", "permanent": false },
    { "source": "/get", "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }], "destination": "/google-play", "permanent": false },
    { "source": "/get", "destination": "https://apps.apple.com/app/id6786614029?pt=128225052&ct=link", "permanent": false }
  ],
  "rewrites": [
    { "source": "/partner-dashboard", "destination": "/api/dashboard" },
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/medicine", "destination": "/" },
    { "source": "/healthcare", "destination": "/" },
    { "source": "/law", "destination": "/" },
    { "source": "/legal", "destination": "/" },
    { "source": "/business", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(fonts|brand|shots|illustrations)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(favicon.ico|og-image.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }]
    }
  ]
}
